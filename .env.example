# Development Environment Configuration
FLASK_ENV=development
SECRET_KEY=dev-fallback-secret-key-123
JWT_SECRET_KEY=dev-jwt-fallback-secret-key-456

# Database
DATABASE_NAME=My_Medical_Shope.db

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email & OTP Providers (dev)
EMAIL_PROVIDER=dev
OTP_STORE_PROVIDER=dev
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_DEFAULT_SENDER=noreply@example.com
OTP_EXPIRY_SECONDS=300
EMAIL_BACKEND=smtp
EMAIL_VERIFY_OTP_EXPIRY_SECONDS=600

# API / client contract
API_PREFIX=/api/v1
ENABLE_DOCS=true
MIN_APP_VERSION=
CORS_ORIGINS=
TRUSTED_PROXY_COUNT=0

# Uploads (MAX_CONTENT_LENGTH in bytes; defaults to (MAX_UPLOAD_MB+1) MB)
MAX_UPLOAD_MB=5
MAX_CONTENT_LENGTH=
ALLOWED_UPLOAD_MIME=image/jpeg,image/png,image/webp,application/pdf

# Admin signup (POST /api/v1/admins/register). Set ADMIN_SIGNUP_CODE in production.
ADMIN_SIGNUP_CODE=
ADMIN_SIGNUP_RATE_LIMIT=10
ADMIN_SIGNUP_RATE_WINDOW_SECONDS=3600

# Google Sign-In (POST /api/v1/auth/google). Web OAuth client ID; never put the client secret here.
GOOGLE_CLIENT_ID=
GOOGLE_LOGIN_RATE_LIMIT=30
GOOGLE_LOGIN_RATE_WINDOW_SECONDS=600

# Domain
IDEMPOTENCY_TTL_HOURS=24
NEAR_EXPIRY_DAYS=90
DB_BACKUP_ON_MIGRATE=true
