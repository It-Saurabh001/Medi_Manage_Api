# Production Environment Configuration (Keys only)
FLASK_ENV=production
# Two different random values, 32+ chars each: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# Database
# Turso (hosted SQLite): data survives restarts/deploys. When set, DATABASE_NAME is ignored.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TURSO_TIMEOUT_SECONDS=15
DATABASE_NAME=

# Optional: create/approve this admin as owner on every start (no shell needed)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email & OTP Providers (prod only)
EMAIL_PROVIDER=prod
OTP_STORE_PROVIDER=prod
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=true
MAIL_DEFAULT_SENDER=
# Render blocks outbound SMTP: use EMAIL_BACKEND=api with Brevo or Resend
EMAIL_BACKEND=api
EMAIL_API_PROVIDER=brevo
EMAIL_API_KEY=
EMAIL_VERIFY_OTP_EXPIRY_SECONDS=600

# Redis (docker-compose: set REDIS_PASSWORD and use redis://:<REDIS_PASSWORD>@redis:6379/0)
REDIS_PASSWORD=
REDIS_URL=
OTP_EXPIRY_SECONDS=300

# API / client contract
API_PREFIX=/api/v1
ENABLE_DOCS=false
MIN_APP_VERSION=
CORS_ORIGINS=
TRUSTED_PROXY_COUNT=1

# Uploads (MAX_CONTENT_LENGTH in bytes; defaults to (MAX_UPLOAD_MB+1) MB)
MAX_UPLOAD_MB=5
MAX_CONTENT_LENGTH=
ALLOWED_UPLOAD_MIME=image/jpeg,image/png,image/webp,application/pdf

# Admin signup (POST /api/v1/admins/register). Set ADMIN_SIGNUP_CODE in production.
ADMIN_SIGNUP_CODE=
ADMIN_SIGNUP_RATE_LIMIT=10
ADMIN_SIGNUP_RATE_WINDOW_SECONDS=3600

# Google Sign-In (POST /api/v1/auth/google). Web OAuth client ID; never put the client secret here.
GOOGLE_CLIENT_ID=
GOOGLE_LOGIN_RATE_LIMIT=30
GOOGLE_LOGIN_RATE_WINDOW_SECONDS=600

# Admin management (true = only the owner admin can create/approve/disable/delete other admins)
ADMIN_SIGNUP_ENABLED=true
ADMIN_MANAGEMENT_OWNER_ONLY=false

# Auth abuse protection (0 disables a limit)
AUTH_IP_RATE_LIMIT=30
AUTH_IP_RATE_WINDOW_SECONDS=600
AUTH_ACCOUNT_RATE_LIMIT=10
AUTH_ACCOUNT_RATE_WINDOW_SECONDS=900
OTP_VERIFY_BUDGET=10
OTP_VERIFY_BUDGET_WINDOW_SECONDS=3600
SIGNUP_RATE_LIMIT=10
SIGNUP_RATE_WINDOW_SECONDS=3600
# true once the app shows the verify-OTP screen after customer signup
REQUIRE_USER_EMAIL_VERIFICATION=false

# Prescriptions: true = private Cloudinary storage + signed URLs valid PRESCRIPTION_URL_TTL_SECONDS
PRESCRIPTION_PRIVATE_STORAGE=false
PRESCRIPTION_URL_TTL_SECONDS=900
# Recommended: res.cloudinary.com (empty = any http(s) host, legacy behaviour)
ALLOWED_PRESCRIPTION_URL_HOSTS=

# Edge guard / Cloudflare (see README "Security")
EDGE_GUARD_ENABLED=true
# Behind Cloudflare: CLIENT_IP_HEADER=CF-Connecting-IP plus ORIGIN_AUTH_SECRET (32+ chars) that a
# Cloudflare Transform Rule adds as request header ORIGIN_AUTH_HEADER
CLIENT_IP_HEADER=
ORIGIN_AUTH_HEADER=X-Origin-Auth
ORIGIN_AUTH_SECRET=
IP_BLOCKLIST=
IP_ALLOWLIST=
GLOBAL_RATE_LIMIT=300
GLOBAL_RATE_WINDOW_SECONDS=60
BLOCK_SCANNER_USER_AGENTS=true
BLOCK_EMPTY_USER_AGENT=false
MAX_URL_LENGTH=2048

# Domain
IDEMPOTENCY_TTL_HOURS=24
NEAR_EXPIRY_DAYS=90
DB_BACKUP_ON_MIGRATE=true
