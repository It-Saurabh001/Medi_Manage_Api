# Production Environment Configuration (Keys only)
FLASK_ENV=production
SECRET_KEY=
JWT_SECRET_KEY=

# Database
DATABASE_NAME=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email & OTP Providers (prod only)
EMAIL_PROVIDER=prod
OTP_STORE_PROVIDER=prod
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=true
MAIL_DEFAULT_SENDER=
# Render blocks outbound SMTP: use EMAIL_BACKEND=api with Brevo or Resend
EMAIL_BACKEND=api
EMAIL_API_PROVIDER=brevo
EMAIL_API_KEY=
EMAIL_VERIFY_OTP_EXPIRY_SECONDS=600

# Redis
REDIS_URL=
OTP_EXPIRY_SECONDS=300

# API / client contract
API_PREFIX=/api/v1
ENABLE_DOCS=false
MIN_APP_VERSION=
CORS_ORIGINS=
TRUSTED_PROXY_COUNT=1

# Uploads (MAX_CONTENT_LENGTH in bytes; defaults to (MAX_UPLOAD_MB+1) MB)
MAX_UPLOAD_MB=5
MAX_CONTENT_LENGTH=
ALLOWED_UPLOAD_MIME=image/jpeg,image/png,image/webp,application/pdf

# Admin signup (POST /api/v1/admins/register). Set ADMIN_SIGNUP_CODE in production.
ADMIN_SIGNUP_CODE=
ADMIN_SIGNUP_RATE_LIMIT=10
ADMIN_SIGNUP_RATE_WINDOW_SECONDS=3600

# Domain
IDEMPOTENCY_TTL_HOURS=24
NEAR_EXPIRY_DAYS=90
DB_BACKUP_ON_MIGRATE=true
